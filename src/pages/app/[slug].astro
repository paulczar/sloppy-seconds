---
import Base from '../../layouts/Base.astro';
import StatChip from '../../components/StatChip.astro';
import ProvenancePanel from '../../components/ProvenancePanel.astro';
import { loadEntries } from '../../lib/entries';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const entries = await loadEntries();
  return entries.map(e => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const allEntries = await loadEntries();
const entry = allEntries.find(e => e.slug === slug);
if (!entry) return;
const { stats } = entry;
---

<Base title={entry.name} description={entry.description}>
  <nav class="breadcrumb">
    <a href={withBase('/')}>Home</a> /
    <a href={withBase(`/c/${entry.category}/`)}>{entry.category}</a> /
    <span>{entry.name}</span>
  </nav>

  <header class="detail-header">
    <h1>{entry.name}</h1>
    <p class="detail-mapping">
      <span>{entry.modelled_on}</span>
      <span class="app-card__arrow">→</span>
      <span>{entry.name}</span>
    </p>
    <div class="detail-chips">
      {stats && (
        <div class="gh-stats gh-stats--large">
          <span class="gh-stat">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Zm0 2.445L6.615 5.5a.75.75 0 0 1-.564.41l-3.097.45 2.24 2.184a.75.75 0 0 1 .216.664l-.528 3.084 2.769-1.456a.75.75 0 0 1 .698 0l2.77 1.456-.53-3.084a.75.75 0 0 1 .216-.664l2.24-2.183-3.096-.45a.75.75 0 0 1-.564-.41L8 2.694Z"/></svg>
            {stats.stars.toLocaleString()}
          </span>
          <span class="gh-stat">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z"/></svg>
            {stats.forks.toLocaleString()}
          </span>
        </div>
      )}
      <StatChip label="license" value={entry.license} />
      <StatChip label="lang" value={entry.language} />
    </div>
    {stats && <p class="as-of">as of {new Date(stats.fetched_at).toLocaleDateString()}</p>}
    {!stats && <p class="as-of">stats pending</p>}
  </header>

  <ProvenancePanel entry={entry} />

  {entry.rendered?.html && (
    <section class="detail-body" set:html={entry.rendered.html} />
  )}

  <a href={entry.repo} target="_blank" rel="noopener noreferrer" class="repo-link">
    View on GitHub →
  </a>
</Base>